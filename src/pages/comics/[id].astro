---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const strips = (await getCollection("comics", ({ data }) => !data.draft))
    .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

  return strips.map((strip, index) => ({
    params: { id: strip.id },
    props: {
      strip,
      prev: strips[index - 1] ?? null,
      next: strips[index + 1] ?? null,
    },
  }));
}

const { strip, prev, next } = Astro.props;
const { title, date, image, alt } = strip.data;

const formatted = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={title}>
  <article class="wrap strip">
    <p class="eyebrow">{formatted}</p>
    <h1>{title}</h1>

    <div class="strip__image">
      <Image
        src={image}
        alt={alt}
        widths={[480, 800, 1200]}
        sizes="(max-width: 900px) 100vw, 900px"
      />
    </div>

    <nav class="strip__nav" aria-label="Comic navigation">
      {prev ? <a href={`/comics/${prev.id}`}>← {prev.data.title}</a> : <span />}
      <a href="/comics">All comics</a>
      {next ? <a href={`/comics/${next.id}`}>{next.data.title} →</a> : <span />}
    </nav>
  </article>
</BaseLayout>

<style>
  .strip { padding: var(--space-4) 0 var(--space-5); }
  .strip h1 { margin: 0.3em 0 var(--space-3); }
  .strip__image { margin-bottom: var(--space-3); }
  .strip__image :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  .strip__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
  }
  .strip__nav a { text-decoration: underline; text-decoration-color: var(--thread); }
  .strip__nav a:hover { text-decoration-color: var(--moss); }

  @media (max-width: 600px) {
    .strip__nav { flex-direction: column; align-items: flex-start; }
  }
</style>
