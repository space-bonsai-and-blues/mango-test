---
import BaseLayout from "../layouts/BaseLayout.astro";
import AppCard from "../components/AppCard.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import WritingCard from "../components/WritingCard.astro";
import IndraNet from "../components/IndraNet.astro";
import { getCollection } from "astro:content";

const writing = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Nara">
  <section class="hero wrap">
    <h1>Different ways of finding order in complexity.</h1>
    <p class="measure hero__dek">
      Systemic thinking consulting, two apps built in conversation with AI, and a
      writing practice that keeps a record of the whole attempt.
    </p>
  </section>

  <section class="grid-top wrap">
    <div class="grid-top__col">
      <p class="eyebrow">Apps</p>
      <AppCard
        name="AI Scout"
        status="live"
        statusLabel="Live"
        description="A structured self-reflection guide with two paths — one for finding clarity when you feel lost, one for finding direction when you're curious. Built on Lovable."
        href="/apps#ai-scout"
      />
      <AppCard
        name="Dhamma — Teachings for Clarity"
        status="paused"
        statusLabel="In development"
        description="Buddhist teachings made accessible for contemporary lay practice, paused pending review from teachers in the Thai Forest Tradition."
        href="/apps#dhamma"
      />
    </div>

    <div class="grid-top__col">
      <p class="eyebrow">Case studies</p>
      <CaseStudyCard
        client="Selected consulting work"
        focus="Systemic thinking · Social innovation"
        summary="Case studies are being prepared. In the meantime, get in touch directly and I'm glad to walk through relevant work."
        placeholder={true}
      />
      <p class="grid-top__more"><a href="/case-studies">More about the consulting practice →</a></p>
    </div>
  </section>

  <section class="writing-band wrap">
    <div class="writing-band__head">
      <p class="eyebrow">Writing — Space Bonsai and Blues</p>
      <a class="writing-band__all" href="/writing">All writing →</a>
    </div>
    <div class="writing-band__list">
      {writing.map((entry) => (
        <WritingCard
          href={`/writing/${entry.id}`}
          title={entry.data.title}
          description={entry.data.description}
          date={entry.data.date}
          publication={entry.data.publication}
        />
      ))}
    </div>
  </section>

  <section class="closing wrap">
    <div class="closing__net">
      <IndraNet />
    </div>
    <div class="closing__quiet">
      <p class="eyebrow">Get in touch</p>
      <p class="measure">
        Consulting inquiries and everything else:
        <a href="mailto:hello@example.com">hello@example.com</a>
      </p>
    </div>
  </section>

  <style>
    .hero { padding: var(--space-5) 0 var(--space-4); }
    .hero__dek { margin-top: var(--space-2); font-size: 1.15rem; color: var(--ink-soft); }

    .grid-top {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
      padding: var(--space-4) 0;
      border-top: 1px solid var(--line);
    }
    .grid-top__more {
      margin-top: var(--space-2);
      font-family: var(--font-mono);
      font-size: 0.85rem;
    }
    .grid-top__more a { text-decoration: underline; text-decoration-color: var(--line); }
    .grid-top__more a:hover { text-decoration-color: var(--moss); }

    .writing-band {
      padding: var(--space-4) 0;
      border-top: 1px solid var(--line);
    }
    .writing-band__head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-bottom: var(--space-2);
    }
    .writing-band__all {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      text-decoration: underline;
      text-decoration-color: var(--line);
    }
    .writing-band__all:hover { text-decoration-color: var(--moss); }

    .closing {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: end;
      gap: var(--space-4);
      padding: var(--space-5) 0 var(--space-3);
      border-top: 1px solid var(--line);
    }
    .closing__quiet { justify-self: end; text-align: right; }

    @media (max-width: 780px) {
      .grid-top { grid-template-columns: 1fr; gap: var(--space-4); }
      .closing { grid-template-columns: 1fr; }
      .closing__quiet { justify-self: start; text-align: left; }
    }
  </style>
</BaseLayout>
