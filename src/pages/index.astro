---
import BaseLayout from "../layouts/BaseLayout.astro";
import AppCard from "../components/AppCard.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import WritingCard from "../components/WritingCard.astro";
import IndraNet from "../components/IndraNet.astro";
import { getCollection } from "astro:content";
import { caseStudies } from "../data/case-studies";

const writing = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const previewCaseStudies = caseStudies.slice(0, 2);
---

<BaseLayout title="Nara">
  <section class="hero wrap">
    <h1>Different ways of finding order in complexity.</h1>
    <p class="measure hero__dek">
      Systemic thinking consulting, two apps built in conversation with AI, and a
      writing practice that keeps a record of the whole attempt.
    </p>
  </section>

  <section class="quad wrap">
    <div class="quad__cell">
      <p class="eyebrow">Apps</p>
      <AppCard
        name="AI Scout"
        status="live"
        statusLabel="Live"
        description="A structured self-reflection guide with two paths — one for finding clarity when you feel lost, one for finding direction when you're curious. Built on Lovable."
        href="/apps#ai-scout"
      />
      <details class="apps-more">
        <summary>More…</summary>
        <div class="apps-more__body">
          <div class="apps-more__head">
            <h3>Dhamma — Teachings for Clarity</h3>
            <span class="apps-more__status">In development</span>
          </div>
          <p>
            Buddhist teachings made accessible for contemporary lay practice,
            paused pending review from teachers in the Thai Forest Tradition.
          </p>
          <a href="/apps#dhamma">Read more about it →</a>
        </div>
      </details>
    </div>

    <div class="quad__cell">
      <p class="eyebrow">Case studies</p>
      {previewCaseStudies.map((cs) => <CaseStudyCard {...cs} />)}
      <p class="quad__more">
        <a href="/case-studies" aria-label="More case studies">More…</a>
      </p>
    </div>

    <div class="quad__cell">
      <p class="eyebrow">Indra's net</p>
      <IndraNet />
    </div>

    <div class="quad__cell">
      <p class="eyebrow">Writing — Space Bonsai and Blues</p>
      {writing.length === 0 ? (
        <p class="measure">Nothing published yet — check back soon.</p>
      ) : (
        writing.map((entry) => (
          <WritingCard
            href={`/writing/${entry.id}`}
            title={entry.data.title}
            description={entry.data.description}
            date={entry.data.date}
            publication={entry.data.publication}
          />
        ))
      )}
      <p class="quad__more">
        <a href="/writing" aria-label="More writing">More…</a>
      </p>
    </div>
  </section>

  <style>
    .hero { padding: var(--space-5) 0 var(--space-4); }
    .hero__dek { margin-top: var(--space-2); font-size: 1.15rem; color: var(--ink-soft); }

    .quad {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5) var(--space-5);
      padding: var(--space-4) 0 var(--space-6);
      border-top: 1px solid var(--line);
    }
    .quad__cell {
      padding-top: var(--space-4);
      border-top: 1px solid var(--line);
    }
    /* top row (Apps, Case studies) doesn't need its own top rule right
       under the shared section rule */
    .quad__cell:nth-child(1),
    .quad__cell:nth-child(2) {
      padding-top: 0;
      border-top: none;
    }

    .quad__more {
      margin-top: var(--space-2);
      font-family: var(--font-mono);
      font-size: 0.85rem;
    }
    .quad__more a { text-decoration: underline; text-decoration-color: var(--thread); }
    .quad__more a:hover { text-decoration-color: var(--moss); }

    /* "More…" disclosure for the paused app */
    .apps-more {
      margin-top: var(--space-2);
      padding-top: var(--space-2);
      border-top: 1px solid var(--line);
    }
    .apps-more summary {
      cursor: pointer;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--ink-soft);
      text-decoration: underline;
      text-decoration-color: var(--thread);
      list-style: none;
    }
    .apps-more summary::-webkit-details-marker { display: none; }
    .apps-more summary:hover { text-decoration-color: var(--moss); }
    .apps-more[open] summary { margin-bottom: var(--space-2); }
    .apps-more__body { padding-top: 0.2em; }
    .apps-more__head {
      display: flex;
      align-items: baseline;
      gap: var(--space-2);
      flex-wrap: wrap;
      margin-bottom: 0.4em;
    }
    .apps-more__head h3 { font-size: 1.05rem; }
    .apps-more__status {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.2em 0.6em;
      border-radius: var(--radius);
      color: var(--ink-soft);
      background: var(--paper-dim);
    }
    .apps-more__body a {
      display: inline-block;
      margin-top: 0.4em;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      text-decoration: underline;
      text-decoration-color: var(--line);
    }
    .apps-more__body a:hover { text-decoration-color: var(--moss); }

    @media (max-width: 780px) {
      .quad { grid-template-columns: 1fr; gap: var(--space-4); }
      .quad__cell { padding-top: var(--space-4); border-top: 1px solid var(--line); }
      .quad__cell:first-child { padding-top: 0; border-top: none; }
    }
  </style>
</BaseLayout>
