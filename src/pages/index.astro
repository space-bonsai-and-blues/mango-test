---
import BaseLayout from "../layouts/BaseLayout.astro";
import AppCard from "../components/AppCard.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import WritingCard from "../components/WritingCard.astro";
import IndraNet from "../components/IndraNet.astro";
import AmbientNet from "../components/AmbientNet.astro";
import { getCollection } from "astro:content";
import { caseStudies } from "../data/case-studies";

const writing = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const previewCaseStudies = caseStudies.slice(0, 2);
---

<BaseLayout title="Nara">
  <section class="hero wrap">
    <AmbientNet />
    <div class="hero__content">
      <h1>Different ways of finding order in complexity.</h1>
      <p class="measure hero__dek">
        Systemic thinking consulting, two apps built in conversation with AI, and a
        writing practice that keeps a record of the whole attempt.
      </p>
    </div>
  </section>

  <section class="quad wrap">
    <div class="quad__col">
      <div class="quad__cell">
        <p class="eyebrow">Apps</p>
        <AppCard
          name="AI Scout"
          status="live"
          statusLabel="Live"
          description="A structured self-reflection guide with two paths — one for finding clarity when you feel lost, one for finding direction when you're curious. Built on Lovable."
          href="/apps#ai-scout"
        />
        <p class="apps-teaser">
          Dhamma app — in development.
          <a href="/apps#dhamma">More →</a>
        </p>
      </div>

      <div class="quad__cell quad__cell--stacked">
        <p class="eyebrow">Indra's net</p>
        <IndraNet />
      </div>
    </div>

    <div class="quad__col">
      <div class="quad__cell">
        <p class="eyebrow">Case studies</p>
        {previewCaseStudies.map((cs) => <CaseStudyCard {...cs} />)}
        <p class="quad__more">
          <a href="/case-studies" aria-label="More case studies">More…</a>
        </p>
      </div>

      <div class="quad__cell quad__cell--stacked">
        <p class="eyebrow">Writing — Space Bonsai and Blues</p>
        {writing.length === 0 ? (
          <p class="measure">Nothing published yet — check back soon.</p>
        ) : (
          writing.map((entry) => (
            <WritingCard
              href={`/writing/${entry.id}`}
              title={entry.data.title}
              description={entry.data.description}
              date={entry.data.date}
              publication={entry.data.publication}
            />
          ))
        )}
        <p class="quad__more">
          <a href="/writing" aria-label="More writing">More…</a>
        </p>
      </div>
    </div>
  </section>

  <style>
    .hero {
      position: relative;
      padding: var(--space-6) 0 var(--space-5);
      min-height: 340px;
      display: flex;
      align-items: center;
    }
    .hero__content {
      position: relative;
      z-index: 1;
    }
    .hero__dek { margin-top: var(--space-2); font-size: 1.15rem; color: var(--ink-soft); }

    .quad {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 var(--space-5);
      padding: var(--space-4) 0 var(--space-6);
      border-top: 1px solid var(--line);
    }
    .quad__col {
      display: flex;
      flex-direction: column;
    }
    .quad__cell--stacked {
      margin-top: var(--space-4);
      padding-top: var(--space-4);
      border-top: 1px solid var(--line);
    }

    .quad__more {
      margin-top: var(--space-2);
      font-family: var(--font-mono);
      font-size: 0.85rem;
    }
    .quad__more a { text-decoration: underline; text-decoration-color: var(--thread); }
    .quad__more a:hover { text-decoration-color: var(--moss); }

    /* quiet one-line teaser for the paused app — a plain link, not an
       inline expand, so tapping it never shifts anything else on the
       page (Indra's net stays put) */
    .apps-teaser {
      margin-top: var(--space-2);
      padding-top: var(--space-2);
      border-top: 1px solid var(--line);
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--ink-soft);
    }
    .apps-teaser a {
      text-decoration: underline;
      text-decoration-color: var(--thread);
    }
    .apps-teaser a:hover { text-decoration-color: var(--moss); }

    @media (max-width: 780px) {
      .quad { grid-template-columns: 1fr; gap: 0; }
      .quad__col:last-child .quad__cell:first-child {
        margin-top: var(--space-4);
        padding-top: var(--space-4);
        border-top: 1px solid var(--line);
      }
    }
  </style>
</BaseLayout>
