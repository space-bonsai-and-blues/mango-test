---
import BaseLayout from "../layouts/BaseLayout.astro";
import AppCard from "../components/AppCard.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import WritingCard from "../components/WritingCard.astro";
import IndraNet from "../components/IndraNet.astro";
import { getCollection } from "astro:content";
import { caseStudies } from "../data/case-studies";

const writing = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const previewCaseStudies = caseStudies.slice(0, 2);
---

<BaseLayout title="Nara" ambientBackdrop={true}>
  <section slot="hero" class="hero wrap">
    <div class="hero__content">
      <h1>Tending order in complexity.</h1>
      <p class="hero__dek">
        Systemic thinking for organizations and communities working through
        change.
      </p>
    </div>
  </section>

  <section class="quad wrap">
    <div class="quad__col">
      <div class="quad__cell">
        <p class="eyebrow">Apps</p>
        <AppCard
          name="AI Scout"
          status="live"
          statusLabel="Live"
          description="A structured self-reflection guide with two paths — one for finding clarity when you feel lost, one for finding direction when you're curious. Built on Lovable."
          href="/apps#ai-scout"
        />
        <p class="apps-teaser">
          Dhamma app — in development.
          <a href="/apps#dhamma">More →</a>
        </p>
      </div>

      <div class="quad__cell quad__cell--stacked indra-row">
        <div class="indra-row__label">
          <p class="eyebrow">Indra's net</p>
        </div>
        <div class="indra-row__net">
          <IndraNet />
        </div>
      </div>
    </div>

    <div class="quad__col">
      <div class="quad__cell">
        <p class="eyebrow">Case studies</p>
        {previewCaseStudies.map((cs) => <CaseStudyCard {...cs} />)}
        <p class="quad__more">
          <a href="/case-studies" aria-label="More case studies">More…</a>
        </p>
      </div>

      <div class="quad__cell quad__cell--stacked">
        <p class="eyebrow">Writing — Space Bonsai and Blues</p>
        {writing.length === 0 ? (
          <p class="measure">Nothing published yet — check back soon.</p>
        ) : (
          writing.map((entry) => (
            <WritingCard
              href={`/writing/${entry.id}`}
              title={entry.data.title}
              description={entry.data.description}
              date={entry.data.date}
              publication={entry.data.publication}
            />
          ))
        )}
        <p class="quad__more">
          <a href="/writing" aria-label="More writing">More…</a>
        </p>
      </div>
    </div>
  </section>

  <style>
    .hero {
      position: relative;
      padding: var(--space-3) 0 var(--space-1);
      min-height: 210px;
    }
    .hero__content {
      position: relative;
      z-index: 1;
    }
    .hero h1 {
      font-size: clamp(2.1rem, 4vw, 3.4rem);
    }
    .hero__dek {
      margin-top: var(--space-2);
      font-size: 1.1rem;
      color: var(--ink-soft);
      max-width: 52rem;
    }

    .quad {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 var(--space-5);
      padding: var(--space-2) 0 var(--space-6);
    }
    .quad__col {
      display: flex;
      flex-direction: column;
    }
    .quad__cell--stacked {
      margin-top: var(--space-2);
      padding-top: var(--space-2);
      border-top: 1px solid var(--line);
    }

    /* Indra's net sits beside its label rather than under it, so the
       label's own line doesn't push the net down further than it needs
       to be — the whole point is getting more of it above the fold. */
    .indra-row {
      display: flex;
      align-items: flex-start;
      gap: var(--space-3);
    }
    .indra-row__label {
      flex: 0 0 auto;
      padding-top: 0.3em;
    }
    .indra-row__net {
      flex: 1 1 auto;
      display: flex;
      justify-content: flex-end;
      /* shift left by roughly half the net's own width (260px max-width,
         so ~130px), and nudge up slightly so the tip lands near the
         label's own line instead of a full row below it */
      padding-right: 130px;
    }
    .indra-row__net :global(.indra-net) {
      margin-top: -8px;
    }

    .quad__more {
      margin-top: var(--space-2);
      font-family: var(--font-mono);
      font-size: 0.85rem;
    }
    .quad__more a { text-decoration: underline; text-decoration-color: var(--thread); }
    .quad__more a:hover { text-decoration-color: var(--moss); }

    /* quiet one-line teaser for the paused app — a plain link, not an
       inline expand, so tapping it never shifts anything else on the
       page (Indra's net stays put) */
    .apps-teaser {
      margin-top: var(--space-1);
      padding-top: var(--space-1);
      border-top: 1px solid var(--line);
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: var(--ink-soft);
    }
    .apps-teaser a {
      text-decoration: underline;
      text-decoration-color: var(--thread);
    }
    .apps-teaser a:hover { text-decoration-color: var(--moss); }

    @media (max-width: 780px) {
      .quad { grid-template-columns: 1fr; gap: 0; }
      .quad__col:last-child .quad__cell:first-child {
        margin-top: var(--space-3);
        padding-top: var(--space-3);
        border-top: 1px solid var(--line);
      }
      .indra-row { flex-direction: column; }
      .indra-row__net {
        justify-content: flex-start;
        padding-right: 0;
      }
      .indra-row__net :global(.indra-net) { margin-top: var(--space-1); }
    }
  </style>
</BaseLayout>
