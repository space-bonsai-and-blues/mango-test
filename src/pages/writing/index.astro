---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const series = ['Space Bonsai', 'Blues', 'Other'] as const;
const grouped = series
  .map((name) => ({ name, entries: entries.filter((e) => e.data.series === name) }))
  .filter((group) => group.entries.length > 0);
---

<BaseLayout
  title="Writing — Nara"
  description="Space Bonsai and Blues — writing on systems, practice, and the space between them."
>
  <section class="wrap page-head">
    <span class="eyebrow">Writing</span>
    <h1>Space Bonsai and Blues</h1>
    <p class="intro">
      Two threads, one instinct: pay close attention, then write down what
      shifted. Space Bonsai leans toward systems and ideas; Blues leans toward
      what it's like to be a person while thinking about them.
    </p>
  </section>

  {
    grouped.map((group) => (
      <section class="wrap series-block">
        <h2>{group.name}</h2>
        <ul class="entry-list">
          {group.entries.map((entry) => (
            <li>
              <a href={`/writing/${entry.id}`} class="entry-link">
                <span class="entry-link__title">{entry.data.title}</span>
                <span class="entry-link__date">
                  {entry.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                  })}
                </span>
              </a>
              {entry.data.excerpt && <p class="entry-link__excerpt">{entry.data.excerpt}</p>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    entries.length === 0 && (
      <section class="wrap series-block">
        <p class="empty-note">
          Nothing published yet. New entries appear here automatically as
          Markdown files are added to <code>src/content/writing/</code>.
        </p>
      </section>
    )
  }
</BaseLayout>

<style>
  .page-head {
    padding-top: var(--space-5);
    padding-bottom: var(--space-4);
  }

  .intro {
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .series-block {
    padding-bottom: var(--space-4);
  }

  .series-block:last-of-type {
    padding-bottom: var(--space-6);
  }

  .entry-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .entry-list li {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .entry-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    text-decoration: none;
  }

  .entry-link__title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-text);
    transition: color 0.2s var(--ease);
  }

  .entry-link:hover .entry-link__title {
    color: var(--color-accent-soft);
  }

  .entry-link__date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-dim);
    white-space: nowrap;
  }

  .entry-link__excerpt {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    margin: var(--space-1) 0 0;
  }

  .empty-note {
    color: var(--color-text-dim);
    font-size: 0.9rem;
  }
</style>
