---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WritingCard from "../../components/WritingCard.astro";
import { getCollection } from "astro:content";

const entries = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Writing"
  description="Space Bonsai and Blues — writing on AI collaboration, contemplative practice, and social innovation."
>
  <section class="wrap page-head">
    <p class="eyebrow">Writing</p>
    <h1>Space Bonsai and Blues.</h1>
    <p class="measure page-head__dek">
      Notes from the same throughline as everything else here — human-AI
      collaboration, contemplative practice, and social innovation, mostly
      worked out in public rather than concluded in private.
    </p>
  </section>

  <section class="wrap list">
    {entries.length === 0 ? (
      <p class="measure">Nothing published yet — check back soon.</p>
    ) : (
      entries.map((entry) => (
        <WritingCard
          href={`/writing/${entry.id}`}
          title={entry.data.title}
          description={entry.data.description}
          date={entry.data.date}
          publication={entry.data.publication}
        />
      ))
    )}
  </section>
</BaseLayout>

<style>
  .page-head { padding: var(--space-5) 0 var(--space-4); }
  .page-head__dek { margin-top: var(--space-2); color: var(--ink-soft); }
  .list { padding-bottom: var(--space-4); border-top: 1px solid var(--line); }
</style>
