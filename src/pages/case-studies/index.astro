---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WritingCard from "../../components/WritingCard.astro";
import { getCollection } from "astro:content";

const entries = (
  await getCollection(
    "writing",
    ({ data }) => !data.draft && data.tags?.includes("case-study")
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Case studies"
  description="Consulting work in systemic thinking and social innovation."
>
  <section class="wrap page-head">
    <p class="eyebrow">Case studies</p>
    <h1>Consulting, in depth.</h1>
    <p class="measure page-head__dek">
      Specific designs from ten years of consulting work, written up as full
      pieces rather than summaries.
    </p>
  </section>

  <section class="wrap list">
    {entries.length === 0 ? (
      <p class="measure">Nothing published yet — check back soon.</p>
    ) : (
      entries.map((entry) => (
        <WritingCard
          href={`/writing/${entry.id}`}
          title={entry.data.title}
          description={entry.data.description}
          date={entry.data.date}
          publication={entry.data.publication}
        />
      ))
    )}
  </section>

  <section class="wrap contact-strip">
    <p class="measure">
      Have a specific engagement in mind? <a href="mailto:hello@example.com">Write directly</a>
      and I'm glad to walk through relevant work that isn't posted here yet.
    </p>
  </section>
</BaseLayout>

<style>
  .page-head { padding: var(--space-5) 0 var(--space-4); }
  .page-head__dek { margin-top: var(--space-2); color: var(--ink-soft); }
  .list { padding: var(--space-2) 0 var(--space-4); border-top: 1px solid var(--line); }
  .contact-strip {
    padding: var(--space-3) 0 var(--space-4);
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
  }
</style>
