---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WritingCard from "../../components/WritingCard.astro";
import { getCollection } from "astro:content";

const entries = (
  await getCollection(
    "writing",
    ({ data }) => !data.draft && data.tags?.includes("case-study")
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// "series" is whichever tag isn't "case-study" itself — e.g. "CSR", "NPO"
const withSeries = entries.map((entry) => ({
  entry,
  series: entry.data.tags?.find((t) => t !== "case-study") ?? "Other",
}));

const seriesList = [...new Set(withSeries.map((e) => e.series))];
---

<BaseLayout
  title="Case studies"
  description="Consulting work in systemic thinking and social innovation."
>
  <section class="wrap page-head">
    <p class="eyebrow">Case studies</p>
    <h1>Consulting, in depth.</h1>
    <p class="measure page-head__dek">
      Specific designs from ten years of consulting work, written up as full
      pieces rather than summaries.
    </p>
  </section>

  {seriesList.length > 1 && (
    <section class="wrap filters" aria-label="Filter by series">
      <button class="filter-btn is-active" data-filter="all">All</button>
      {seriesList.map((series) => (
        <button class="filter-btn" data-filter={series}>{series}</button>
      ))}
    </section>
  )}

  <section class="wrap list" id="case-study-list">
    {withSeries.length === 0 ? (
      <p class="measure">Nothing published yet — check back soon.</p>
    ) : (
      withSeries.map(({ entry, series }) => (
        <WritingCard
          href={`/writing/${entry.id}`}
          title={entry.data.title}
          description={entry.data.description}
          date={entry.data.date}
          publication={entry.data.publication}
          series={series}
        />
      ))
    )}
  </section>

  <section class="wrap contact-strip">
    <p class="measure">
      Have a specific engagement in mind? <a href="mailto:hello@example.com">Write directly</a>
      and I'm glad to walk through relevant work that isn't posted here yet.
    </p>
  </section>
</BaseLayout>

<style>
  .page-head { padding: var(--space-5) 0 var(--space-4); }
  .page-head__dek { margin-top: var(--space-2); color: var(--ink-soft); }
  .filters {
    display: flex;
    gap: var(--space-2);
    padding-bottom: var(--space-2);
  }
  .filter-btn {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.35em 0.9em;
    color: var(--ink-soft);
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .filter-btn:hover { color: var(--ink); border-color: var(--moss); }
  .filter-btn.is-active {
    color: var(--paper);
    background: var(--moss);
    border-color: var(--moss);
  }
  .list { padding: var(--space-2) 0 var(--space-4); border-top: 1px solid var(--line); }
  .contact-strip {
    padding: var(--space-3) 0 var(--space-4);
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
  }
</style>

<script>
  const buttons = document.querySelectorAll(".filter-btn");
  const cards = document.querySelectorAll("#case-study-list [data-series]");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");

      cards.forEach((card) => {
        const show = filter === "all" || card.dataset.series === filter;
        card.style.display = show ? "" : "none";
      });
    });
  });
</script>
