---
import "../styles/global.css";
import AmbientNet from "../components/AmbientNet.astro";

interface Props {
  title: string;
  description?: string;
  // When true, the ambient net backdrop spans the header + hero region
  // together, so the pattern reads as reaching the true top of the page
  // rather than stopping at the hero's own box. Homepage-only.
  ambientBackdrop?: boolean;
}

const {
  title,
  description = "Nara — systemic thinking, social innovation, and contemplative practice, in conversation with AI.",
  ambientBackdrop = false,
} = Astro.props;

const nav = [
  { href: "/apps", label: "Apps" },
  { href: "/case-studies", label: "Case studies" },
  { href: "/writing", label: "Writing" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Nara</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,380..600;1,9..144,380..500&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="top-band">
      {ambientBackdrop && <AmbientNet />}
      <header class="site-header">
        <div class="wrap site-header__inner">
          <a class="wordmark" href="/">Nara</a>
          <nav aria-label="Primary">
            <ul>
              {nav.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
        </div>
      </header>
      <slot name="hero" />
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p class="eyebrow">© {new Date().getFullYear()} Nara</p>
        <ul class="site-footer__links">
          <li><a href="/writing">Space Bonsai and Blues</a></li>
          <li><a href="mailto:hello@example.com">Get in touch</a></li>
        </ul>
      </div>
    </footer>

    <style>
      .top-band {
        position: relative;
        z-index: 0;
      }
      .site-header {
        padding: var(--space-3) 0 var(--space-2);
        position: relative;
        z-index: 1;
      }
      .site-header__inner {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-2);
        flex-wrap: wrap;
      }
      .wordmark {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 1.4rem;
        color: var(--brass);
        text-decoration: none;
      }
      nav ul {
        display: flex;
        gap: var(--space-3);
        list-style: none;
        margin: 0;
        padding: 0;
      }
      nav a {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--ink-soft);
        border-bottom: 1px solid transparent;
        padding-bottom: 2px;
        transition: border-color 0.15s ease, color 0.15s ease;
      }
      nav a:hover, nav a:focus-visible {
        color: var(--ink);
        border-bottom-color: var(--moss);
      }

      main {
        min-height: 60vh;
      }

      .site-footer {
        margin-top: var(--space-6);
        padding: var(--space-3) 0 var(--space-4);
        border-top: 1px solid var(--line);
      }
      .site-footer__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--space-2);
      }
      .site-footer__links {
        display: flex;
        gap: var(--space-3);
        list-style: none;
        margin: 0;
        padding: 0;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        letter-spacing: 0.04em;
      }
      .site-footer__links a { text-decoration: none; color: var(--ink-soft); }
      .site-footer__links a:hover { color: var(--ink); }
    </style>
  </body>
</html>
