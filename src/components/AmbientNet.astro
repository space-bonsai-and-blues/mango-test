---
// A quiet, non-interactive echo of the Indra's net motif, sitting behind
// the hero headline. Same idea — points and threads, no fixed pattern —
// but decorative and ambient rather than tappable. Deliberately faint: it
// should read as texture, not compete with the interactive net further
// down the page, which stays the one place attention is asked for.
const points = [
  { id: "p0", x: 178.4, y: 350.9 },
  { id: "p1", x: 629.6, y: 236.7 },
  { id: "p2", x: 227.4, y: 406.6 },
  { id: "p3", x: 795.5, y: 254.7 },
  { id: "p4", x: 504.9, y: 105.0 },
  { id: "p5", x: 23.1, y: 178.1 },
  { id: "p6", x: 581.9, y: -220 },
  { id: "p7", x: 782.0, y: 102.9 },
  { id: "p8", x: 243.4, y: -260 },
  { id: "p9", x: 977.7, y: 377.4 },
  { id: "p10", x: 860.0, y: 310.8 },
  { id: "p11", x: 497.7, y: 39.8 },
  { id: "p12", x: 933.9, y: 176.7 },
  { id: "p13", x: 168.6, y: 420.1 },
  { id: "p14", x: 139.9, y: 515 },
  { id: "p15", x: 455.0, y: 276.2 },
  { id: "p16", x: 349.2, y: 239.8 },
  { id: "p17", x: 851.3, y: 104.3 },
  { id: "p18", x: 950.0, y: 500 },
  { id: "p19", x: 744.6, y: 390.5 },
  { id: "p20", x: 577.5, y: 372.5 },
  { id: "p21", x: 137.6, y: 235.2 },
];

const edges = [
  ["p0", "p2"], ["p0", "p5"], ["p0", "p13"], ["p0", "p21"],
  ["p1", "p3"], ["p1", "p20"],
  ["p2", "p13"], ["p2", "p14"], ["p2", "p16"],
  ["p3", "p7"], ["p3", "p10"], ["p3", "p19"],
  ["p4", "p6"], ["p4", "p11"],
  ["p5", "p21"],
  ["p6", "p11"],
  ["p7", "p17"],
  ["p8", "p16"], ["p8", "p21"],
  ["p9", "p10"], ["p9", "p18"],
  ["p10", "p12"], ["p10", "p18"], ["p10", "p19"],
  ["p12", "p17"],
  ["p13", "p14"],
  ["p15", "p16"], ["p15", "p20"],
];

const pointFor = (id: string) => points.find((p) => p.id === id)!;

// A handful of points twinkle very slowly and out of sync with each
// other — enough to read as quietly alive, not enough to distract from
// the headline sitting on top of it.
const twinkleIds = new Set(["p1", "p4", "p10", "p16", "p20", "p7"]);
---

<div class="ambient-net" aria-hidden="true">
  <svg viewBox="0 0 1000 480" preserveAspectRatio="none">
    <g class="ambient-net__edges">
      {edges.map(([a, b], i) => {
        const pa = pointFor(a);
        const pb = pointFor(b);
        return <line x1={pa.x} y1={pa.y} x2={pb.x} y2={pb.y} style={`--d:${(i % 7) * 0.6}s`} />;
      })}
    </g>
    <g class="ambient-net__points">
      {points.map((p, i) => (
        <circle
          cx={p.x}
          cy={p.y}
          r={twinkleIds.has(p.id) ? 3.4 : 2.2}
          class={twinkleIds.has(p.id) ? "twinkle" : ""}
          style={`--d:${(i % 5) * 0.9}s`}
        />
      ))}
    </g>
  </svg>
</div>

<style>
  .ambient-net {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .ambient-net svg {
    width: 100%;
    height: 100%;
  }
  .ambient-net__edges line {
    stroke: var(--ink-soft);
    stroke-width: 1;
    opacity: 0.1;
  }
  .ambient-net__points circle {
    fill: var(--ink-soft);
    opacity: 0.16;
  }
  .ambient-net__points circle.twinkle {
    animation: ambient-twinkle 7s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }
  .ambient-net__edges line {
    animation: ambient-fade 9s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }

  @keyframes ambient-twinkle {
    0%, 100% { opacity: 0.14; }
    50% { opacity: 0.4; }
  }
  @keyframes ambient-fade {
    0%, 100% { opacity: 0.08; }
    50% { opacity: 0.2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-net__points circle.twinkle,
    .ambient-net__edges line {
      animation: none;
      opacity: 0.14;
    }
  }
</style>
