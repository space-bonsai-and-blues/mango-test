---
interface Props {
  name: string;
  status: "live" | "paused";
  statusLabel: string;
  description: string;
  href?: string;
}
const { name, status, statusLabel, description, href } = Astro.props;
---

<article class="app-card" data-status={status}>
  <div class="app-card__head">
    <h3>{name}</h3>
    <span class="app-card__status">{statusLabel}</span>
  </div>
  <p class="measure">{description}</p>
  {href && (
    <a class="app-card__link" href={href} target="_blank" rel="noopener noreferrer">
      Open {name} ↗
    </a>
  )}
</article>

<style>
  .app-card {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
  }
  .app-card:first-child { border-top: none; padding-top: 0; }
  .app-card__head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-1);
  }
  .app-card__status {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2em 0.6em;
    border-radius: var(--radius);
    color: var(--paper);
    background: var(--status-live);
  }
  .app-card[data-status="paused"] .app-card__status {
    background: var(--paper-dim);
    color: var(--ink-soft);
  }
  .app-card__link {
    display: inline-block;
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: underline;
    text-decoration-color: var(--line);
  }
  .app-card__link:hover { text-decoration-color: var(--moss); }
</style>
