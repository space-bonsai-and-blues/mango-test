---
// A small net of jewels: tap a node and a different pattern of
// connections lights each time. No fixed "correct" pattern —
// deliberately illustrates the Cynefin Complex domain, where
// cause and effect can only be understood in retrospect.
const nodes = [
  { id: "n0", x: 150, y: 150, r: 7 }, // centre jewel
  { id: "n1", x: 150.0, y: 40.0, r: 5 },
  { id: "n2", x: 205.0, y: 54.7, r: 5 },
  { id: "n3", x: 245.3, y: 95.0, r: 5 },
  { id: "n4", x: 260.0, y: 150.0, r: 5 },
  { id: "n5", x: 245.3, y: 205.0, r: 5 },
  { id: "n6", x: 205.0, y: 245.3, r: 5 },
  { id: "n7", x: 150.0, y: 260.0, r: 5 },
  { id: "n8", x: 95.0, y: 245.3, r: 5 },
  { id: "n9", x: 54.7, y: 205.0, r: 5 },
  { id: "n10", x: 40.0, y: 150.0, r: 5 },
  { id: "n11", x: 54.7, y: 95.0, r: 5 },
  { id: "n12", x: 95.0, y: 54.7, r: 5 },
];

const spokes = Array.from({ length: 12 }, (_, i) => ["n0", `n${i + 1}`]);
const ring = Array.from({ length: 12 }, (_, i) => [
  `n${i + 1}`,
  `n${((i + 1) % 12) + 1}`,
]);
const diagonals = [
  ["n1", "n7"],
  ["n4", "n10"],
  ["n2", "n9"],
  ["n5", "n12"],
];
const edges = [...spokes, ...ring, ...diagonals];

const pointFor = (id: string) => nodes.find((n) => n.id === id)!;
---

<div class="indra-net">
  <svg
    viewBox="0 0 300 300"
    role="group"
    aria-label="Indra's net — an interactive diagram. Select any point to see a different set of connections light up."
  >
    <g class="edges">
      {edges.map(([a, b]) => {
        const pa = pointFor(a);
        const pb = pointFor(b);
        return (
          <line
            data-edge={`${a}|${b}`}
            data-a={a}
            data-b={b}
            x1={pa.x}
            y1={pa.y}
            x2={pb.x}
            y2={pb.y}
          />
        );
      })}
    </g>
    <g class="nodes">
      {nodes.map((n) => (
        <circle
          class="node"
          data-node={n.id}
          cx={n.x}
          cy={n.y}
          r={n.r}
          tabindex="0"
          role="button"
          aria-label={n.id === "n0" ? "Centre point" : `Point ${n.id.slice(1)}`}
        ></circle>
      ))}
    </g>
  </svg>
  <p class="indra-net__caption">tap a point — a different pattern lights each time.</p>
</div>

<script>
  type Edge = { a: string; b: string; el: SVGLineElement };

  function wireUp(container: Element) {
    const svg = container.querySelector("svg")!;
    const edgeEls = Array.from(svg.querySelectorAll<SVGLineElement>("line[data-edge]"));
    const nodeEls = Array.from(svg.querySelectorAll<SVGCircleElement>("circle[data-node]"));

    const edges: Edge[] = edgeEls.map((el) => ({
      a: el.dataset.a!,
      b: el.dataset.b!,
      el,
    }));

    const adjacency = new Map<string, Edge[]>();
    for (const e of edges) {
      if (!adjacency.has(e.a)) adjacency.set(e.a, []);
      if (!adjacency.has(e.b)) adjacency.set(e.b, []);
      adjacency.get(e.a)!.push(e);
      adjacency.get(e.b)!.push(e);
    }

    let activeTimers: number[] = [];

    function clearActive() {
      activeTimers.forEach((t) => window.clearTimeout(t));
      activeTimers = [];
      edgeEls.forEach((el) => el.classList.remove("lit"));
      nodeEls.forEach((el) => el.classList.remove("lit"));
    }

    function otherEnd(edge: Edge, from: string) {
      return edge.a === from ? edge.b : edge.a;
    }

    function lightFrom(startId: string) {
      clearActive();

      const steps = 5 + Math.floor(Math.random() * 5); // 5–9 hops
      let current = startId;
      let previousEdge: Edge | null = null;
      const path: { node: string; edge: Edge | null }[] = [{ node: current, edge: null }];

      for (let i = 0; i < steps; i++) {
        const options = (adjacency.get(current) ?? []).filter((e) => e !== previousEdge);
        if (options.length === 0) break;
        const next = options[Math.floor(Math.random() * options.length)];
        current = otherEnd(next, current);
        previousEdge = next;
        path.push({ node: current, edge: next });
      }

      path.forEach((step, i) => {
        const t = window.setTimeout(() => {
          const nodeEl = svg.querySelector<SVGCircleElement>(`circle[data-node="${step.node}"]`);
          nodeEl?.classList.add("lit");
          if (step.edge) step.edge.el.classList.add("lit");
        }, i * 110);
        activeTimers.push(t);
      });

      const fadeTimer = window.setTimeout(() => {
        clearActive();
      }, path.length * 110 + 1500);
      activeTimers.push(fadeTimer);
    }

    nodeEls.forEach((el) => {
      const id = el.dataset.node!;
      el.addEventListener("click", () => lightFrom(id));
      el.addEventListener("keydown", (ev) => {
        if (ev.key === "Enter" || ev.key === " ") {
          ev.preventDefault();
          lightFrom(id);
        }
      });
    });
  }

  document.querySelectorAll(".indra-net").forEach(wireUp);
</script>

<style>
  .indra-net {
    max-width: 260px;
  }
  .indra-net svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .edges line {
    stroke: var(--line);
    stroke-width: 1;
    transition: stroke 0.4s ease, stroke-width 0.4s ease, opacity 0.4s ease;
  }
  .edges line.lit {
    stroke: var(--thread);
    stroke-width: 1.4;
  }
  .node {
    fill: var(--paper-dim);
    stroke: var(--ink-soft);
    stroke-width: 1;
    cursor: pointer;
    transition: fill 0.35s ease, stroke 0.35s ease, r 0.35s ease;
  }
  .node:hover, .node:focus-visible {
    fill: var(--moss-bright);
    outline: none;
  }
  .node.lit {
    fill: var(--brass);
    stroke: var(--brass);
  }
  .indra-net__caption {
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
    max-width: 26ch;
  }
</style>
