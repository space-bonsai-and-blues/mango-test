---
// A net of jewels at irregular depths: tap a point and a different pattern
// of connections lights — a different colour combination each time too.
// No fixed "correct" pattern — deliberately illustrates the Cynefin Complex
// domain, where cause and effect can only be understood in retrospect.
//
// The layout is intentionally irregular rather than a tidy circle: real
// interdependence doesn't arrange itself symmetrically. Size, opacity, and
// a soft glow on each node stand in for depth — a full 3D render felt like
// more machinery than a homepage accent needs, but the same "jewels at
// varying distance, each reflecting the others" idea comes through with
// these lighter cues.
const nodes = [
  { id: "n0", x: 150, y: 150, r: 8, depth: 1.3 }, // centre jewel — closest
  { id: "n1", x: 144.5, y: 69.1, r: 5, depth: 1.04 },
  { id: "n2", x: 186.6, y: 52.5, r: 4.4, depth: 0.87 },
  { id: "n3", x: 228.8, y: 84.5, r: 3.6, depth: 0.67 },
  { id: "n4", x: 226.2, y: 148.1, r: 3.8, depth: 0.7 },
  { id: "n5", x: 257.0, y: 207.7, r: 3.9, depth: 0.72 },
  { id: "n6", x: 214.6, y: 238.6, r: 5.8, depth: 1.22 },
  { id: "n7", x: 147.2, y: 245.8, r: 5.9, depth: 1.24 },
  { id: "n8", x: 107.7, y: 266.0, r: 4.3, depth: 0.82 },
  { id: "n9", x: 87.5, y: 198.5, r: 4.4, depth: 0.84 },
  { id: "n10", x: 67.8, y: 140.0, r: 5.2, depth: 1.0 },
  { id: "n11", x: 70.9, y: 98.5, r: 5.1, depth: 0.98 },
  { id: "n12", x: 101.8, y: 91.8, r: 4.1, depth: 0.77 },
];

const spokes = Array.from({ length: 12 }, (_, i) => ["n0", `n${i + 1}`]);
const ring = Array.from({ length: 12 }, (_, i) => [
  `n${i + 1}`,
  `n${((i + 1) % 12) + 1}`,
]);
const diagonals = [
  ["n1", "n7"],
  ["n4", "n10"],
  ["n2", "n9"],
  ["n5", "n12"],
];
const edges = [...spokes, ...ring, ...diagonals];

const pointFor = (id: string) => nodes.find((n) => n.id === id)!;
---

<div class="indra-net">
  <svg
    viewBox="0 0 300 300"
    role="group"
    aria-label="Indra's net — an interactive diagram. Select any point to see a different set of connections light up."
  >
    <defs>
      <filter id="indra-glow" x="-120%" y="-120%" width="340%" height="340%">
        <feGaussianBlur stdDeviation="4.2" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>
    <g class="edges">
      {edges.map(([a, b]) => {
        const pa = pointFor(a);
        const pb = pointFor(b);
        return (
          <line
            data-edge={`${a}|${b}`}
            data-a={a}
            data-b={b}
            x1={pa.x}
            y1={pa.y}
            x2={pb.x}
            y2={pb.y}
          />
        );
      })}
    </g>
    <g class="nodes">
      {nodes.map((n) => (
        <circle
          class="node"
          data-node={n.id}
          data-depth={n.depth}
          cx={n.x}
          cy={n.y}
          r={n.r}
          style={`opacity:${0.45 + n.depth * 0.35}`}
          tabindex="0"
          role="button"
          aria-label={n.id === "n0" ? "Centre point" : `Point ${n.id.slice(1)}`}
        ></circle>
      ))}
    </g>
  </svg>
  <p class="indra-net__caption">tap a point — a different pattern lights each time.</p>
</div>

<script>
  type Edge = { a: string; b: string; el: SVGLineElement };

  // Jewel palette for lit states — green, blue, and violet, cycling per hop
  // so a single tap can surface more than one of the net's colours at once.
  const JEWEL_COLORS = ["var(--moss-bright)", "var(--indigo)", "var(--violet)"];

  function wireUp(container: Element) {
    const svg = container.querySelector("svg")!;
    const edgeEls = Array.from(svg.querySelectorAll<SVGLineElement>("line[data-edge]"));
    const nodeEls = Array.from(svg.querySelectorAll<SVGCircleElement>("circle[data-node]"));

    const edges: Edge[] = edgeEls.map((el) => ({
      a: el.dataset.a!,
      b: el.dataset.b!,
      el,
    }));

    const adjacency = new Map<string, Edge[]>();
    for (const e of edges) {
      if (!adjacency.has(e.a)) adjacency.set(e.a, []);
      if (!adjacency.has(e.b)) adjacency.set(e.b, []);
      adjacency.get(e.a)!.push(e);
      adjacency.get(e.b)!.push(e);
    }

    let activeTimers: number[] = [];

    function clearActive() {
      activeTimers.forEach((t) => window.clearTimeout(t));
      activeTimers = [];
      edgeEls.forEach((el) => {
        el.classList.remove("lit");
        el.style.removeProperty("--jewel");
      });
      nodeEls.forEach((el) => {
        el.classList.remove("lit");
        el.style.removeProperty("--jewel");
      });
    }

    function otherEnd(edge: Edge, from: string) {
      return edge.a === from ? edge.b : edge.a;
    }

    function lightFrom(startId: string) {
      clearActive();

      const steps = 5 + Math.floor(Math.random() * 5); // 5–9 hops
      let current = startId;
      let previousEdge: Edge | null = null;
      const path: { node: string; edge: Edge | null }[] = [{ node: current, edge: null }];

      for (let i = 0; i < steps; i++) {
        const options = (adjacency.get(current) ?? []).filter((e) => e !== previousEdge);
        if (options.length === 0) break;
        const next = options[Math.floor(Math.random() * options.length)];
        current = otherEnd(next, current);
        previousEdge = next;
        path.push({ node: current, edge: next });
      }

      path.forEach((step, i) => {
        const color = JEWEL_COLORS[i % JEWEL_COLORS.length];
        const t = window.setTimeout(() => {
          const nodeEl = svg.querySelector<SVGCircleElement>(`circle[data-node="${step.node}"]`);
          nodeEl?.style.setProperty("--jewel", color);
          nodeEl?.classList.add("lit");
          if (step.edge) {
            step.edge.el.style.setProperty("--jewel", color);
            step.edge.el.classList.add("lit");
          }
        }, i * 130);
        activeTimers.push(t);
      });

      const fadeTimer = window.setTimeout(() => {
        clearActive();
      }, path.length * 130 + 1600);
      activeTimers.push(fadeTimer);
    }

    nodeEls.forEach((el) => {
      const id = el.dataset.node!;
      el.addEventListener("click", () => lightFrom(id));
      el.addEventListener("keydown", (ev) => {
        if (ev.key === "Enter" || ev.key === " ") {
          ev.preventDefault();
          lightFrom(id);
        }
      });
    });
  }

  document.querySelectorAll(".indra-net").forEach(wireUp);
</script>

<style>
  .indra-net {
    max-width: 260px;
  }
  .indra-net svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .edges line {
    stroke: var(--line);
    stroke-width: 1;
    transition: stroke 0.4s ease, stroke-width 0.4s ease, filter 0.4s ease;
  }
  .edges line.lit {
    stroke: var(--jewel, var(--thread));
    stroke-width: 1.6;
    filter: url(#indra-glow);
  }
  .node {
    fill: var(--paper-dim);
    stroke: var(--ink-soft);
    stroke-width: 1;
    cursor: pointer;
    transition: fill 0.35s ease, stroke 0.35s ease, r 0.35s ease, filter 0.35s ease;
  }
  .node:hover, .node:focus-visible {
    fill: var(--moss-bright);
    outline: none;
  }
  .node.lit {
    fill: var(--jewel, var(--brass));
    stroke: var(--jewel, var(--brass));
    r: 7.5;
    filter: url(#indra-glow);
  }
  .indra-net__caption {
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
    max-width: 26ch;
  }
</style>
