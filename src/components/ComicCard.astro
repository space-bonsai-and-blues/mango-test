---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  title: string;
  date: Date;
  image: ImageMetadata;
  alt: string;
}
const { href, title, date, image, alt } = Astro.props;
const formatted = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<article class="comic-card">
  <a href={href} class="comic-card__link">
    <Image
      src={image}
      alt={alt}
      class="comic-card__thumb"
      widths={[320, 480, 640]}
      sizes="(max-width: 780px) 100vw, 320px"
    />
    <p class="eyebrow comic-card__meta">{formatted}</p>
    <h3>{title}</h3>
  </a>
</article>

<style>
  .comic-card__link { display: block; text-decoration: none; }
  .comic-card__thumb {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    display: block;
  }
  .comic-card__meta { margin-top: var(--space-1); }
  .comic-card h3 {
    margin: 0.2em 0 0;
    transition: color 0.15s ease;
  }
  .comic-card__link:hover h3,
  .comic-card__link:focus-visible h3 {
    color: var(--moss);
  }
</style>
