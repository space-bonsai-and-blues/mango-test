---
interface Props {
  client: string;
  focus: string;
  summary: string;
  placeholder?: boolean;
}
const { client, focus, summary, placeholder = false } = Astro.props;
---

<article class="cs-card" data-placeholder={placeholder}>
  <p class="eyebrow">{focus}</p>
  <h3>{client}</h3>
  <p class="measure">{summary}</p>
</article>

<style>
  .cs-card {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
  }
  .cs-card:first-child { border-top: none; padding-top: 0; }
  .cs-card h3 { margin: 0.2em 0 0.4em; }
  .cs-card[data-placeholder="true"] {
    opacity: 0.68;
  }
  .cs-card[data-placeholder="true"] h3::after {
    content: " — coming soon";
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-style: normal;
    text-transform: none;
    color: var(--ink-soft);
  }
</style>
